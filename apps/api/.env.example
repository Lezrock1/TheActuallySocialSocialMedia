DATABASE_URL="postgresql://app:app@localhost:5432/app"
JWT_SECRET="change-me-to-a-long-random-string"
AI_KEY_ENCRYPTION_SECRET="change-me-to-a-32-byte-secret!!"
# Generate once for the first account on a fresh database; remove after setup.
BOOTSTRAP_INVITE_CODE="change-me-bootstrap-invite-code1"
# Optional shared OpenRouter key for the default free-model configuration.
OPENROUTER_API_KEY=""
# Optional Web Push keys; generate with `pnpm --filter @app/api exec web-push generate-vapid-keys`.
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:admin@intouchsocial.com"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development
S3_ENDPOINT="http://localhost:8333"
S3_BUCKET="media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="anonymous"
S3_SECRET_ACCESS_KEY="anonymous"
